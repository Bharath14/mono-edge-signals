# Postgres. Locally the Docker or Homebrew database; on Vercel the Supabase
# transaction pooler string (port 6543).
DATABASE_URL=postgresql://mill:mill@localhost:5432/millsignals

# Supabase Auth (Project Settings > API). Leave both empty for local
# development without login; production refuses to run without them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
